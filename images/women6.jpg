2 stars because OK for BodyPump.</div><div class="bv-rnr__sc-16dr7i1-13 flweSz"></div><div class="bv-rnr__sc-1grr47e-0 cxGpQu"><div class="bv-rnr__sc-1grr47e-1 bhTbti"><img src="./women6_files/0d15984f-2a9e-483a-a644-5f44404db9a5" alt="" width="50" height="50"></div><div class="bv-rnr__sc-1grr47e-2 dDdHob"><p class="bv-rnr__sc-1grr47e-3 hCiaBm">Originally posted on Nike</p></div></div></div></div></div></div><div class="bv-rnr__sc-16dr7i1-11 bDrXSA"></div></div></div></div></section><section id="bv-review-249964938" aria-label="2 out of 8 reviews, ratings 2 out of 5."><div class="bv-rnr__sc-16dr7i1-1 jtRfje"><div data-bv-v="contentItem" itemscope="" class="bv-rnr__sc-16dr7i1-0 bv-rnr__sc-16dr7i1-23 jZQSED bfiwNO"><div data-bv-v="inlineProfile" class="bv-rnr__sc-16dr7i1-2 hGCEeE"><div class="bv-rnr__emkap-0 kuRIjh"><div role="presentation" class="bv-rnr__emkap-4 eQcxjy"><div role="presentation" class="bv-rnr__sc-1r4hv38-3 biYZeN"><div itemscope="" class="bv-rnr__sc-1r4hv38-2 kPtqzh"><span disabled="" class="bv-rnr__sc-1r4hv38-0 dWWqxa">Deanne520971444</span></div></div></div><div class="bv-rnr__sc-16dr7i1-20 dMoRVl"></div><div class="bv-rnr__emkap-5 hJYLFq"><div class="bv-rnr__emkap-1 dUNcFq"><span></span></div><div class="bv-rnr__emkap-2 qqvVa"><div class="bv-rnr__sc-1yppnmf-0 fJzmAF"><div class="bv-rnr__sc-1yppnmf-1 eWJSfB"><div class="bv-rnr__f9cpbf-0 fIWANC"><span class="bv-rnr__f9cpbf-1 bOwvYf"> Total reviews posted </span><span class="bv-rnr__f9cpbf-2 cMtWWH">1</span></div></div></div></div><div class="bv-rnr__emkap-3 izbxwW"><div class="bv-rnr__sc-1sgyyik-1 kFamwJ"></div></div></div></div></div><div class="bv-rnr__sc-16dr7i1-26 iDmrQE"><div class="bv-rnr__sc-16dr7i1-27"><div class="bv-rnr__sc-16dr7i1-10 jLOzaq"><div data-bv-v="contentHeader" class="bv-rnr__sc-16dr7i1-22 hFsuhm"><div role="img" aria-label="2 out of 5 stars." itemscope="" class="bv-rnr__sc-16dr7i1-19 dzPKPO"><abbr title="2 out of 5 stars." aria-hidden="true" class="bv-rnr__reme6t-0 QXhtp"><svg x