eton .intel-rec-skeleton-title {\n      margin-top: 12px;\n      margin-bottom: 0px;\n\n      height: 0px;\n    }\n\n    .intel-rec-skeleton-ribbon-box {\n      width: auto;\n      display: flex;\n      flex-direction: row;\n      flex-wrap: nowrap;\n      overflow: hidden;\n\n      margin-left: calc(-1 * (var(--slide-spacing) / 2));\n      margin-right: calc(-1 * (var(--slide-spacing) / 2));\n    }\n\n    .intel-rec-skeleton-ribbon-item {\n      display: flex;\n      flex-direction: column;\n      justify-content: space-between;\n      gap: 12px;\n\n      padding-left: calc(var(--slide-spacing, 0) / 2);\n      padding-right: calc(var(--slide-spacing, 0) / 2);\n\n      width: var(--slide-width, 105px);\n      min-width: var(--slide-width, 105px);\n\n      @supports ((-webkit-touch-callout: none) and (not (translate: none))) {\n        margin-right: 12px;\n      }\n    }\n\n    .intel-rec-skeleton-ribbon-image {\n      aspect-ratio: var(--slide-ratio, '3/4');\n      padding-bottom: 12px;\n      height: auto;\n      width: 100%;\n    }\n\n    .intel-rec-skeleton-ribbon-title-container {\n      display: flex;\n      flex-direction: column;\n      gap: 4px;\n      margin-bottom: 4px;\n    }\n\n    .price-top .intel-rec-skeleton-ribbon-title-container {\n      flex-direction: column-reverse;\n    }\n\n    .price-top .intel-rec-skeleton-ribbon-title-container \u003e :nth-child(3) {\n      display: none;\n    }\n\n    .price-top .intel-rec-skeleton-ribbon-title-container \u003e :last-child {\n      margin-top: 8px;\n    }\n\n    .intel-rec-skeleton-divider {\n      margin: 0;\n      flex-shrink: 0;\n      border-width: 0;\n      border-style: solid;\n      border-color: var(--components-divider-default-border-color, rgba(238, 238, 238, 1));\n      border-bottom-width: thin;\n      margin-top: 12px;\n    }\n\n    @supports (aspect-ratio: var(--slide-ratio, '3/4')) {\n      .intel-rec-skeleton-ribbon-image {\n        aspect-ratio: var(--slide-ratio, '3/4');\n      }\n    }\n    @supports not (aspect-ratio: var(--slide-ratio, '3/4')) {\n      .intel-rec-skeleton-ribbon-image {\n        height: var(--slide-ratio-fallback-height, 100%);\n      }\n    }\n    @media (min-width: 0) {\n      .intel-rec-skeleton-ribbon-box {\n        width: auto;\n        display: flex;\n        flex-direction: row;\n        flex-wrap: nowrap;\n      }\n      .intel-rec-skeleton-ribbon-item {\n        --slide-spacing: 12px;\n        --slide-width: 144px;\n        --slide-max-width: 144px;\n        --slide-min-width: 144px;\n      }\n    }\n\n    @media (min-width: 400px) {\n      .intel-rec-skeleton-ribbon-item {\n        --slide-spacing: 12px;\n        --slide-width: 144px;\n        --slide-max-width: 144px;\n        --slide-min-width: 144px;\n      }\n    }\n\n    @media (min-width: 768px) {\n      .intel-rec-skeleton-ribbon-box {\n        flex-wrap: nowrap;\n      }\n      .intel-rec-skeleton-ribbon-item {\n        --slide-spacing: 16px;\n        flex: 0 0 calc(100% / var(--slides-per-page-md));\n\n        width: auto;\n        min-width: auto;\n      }\n    }\n\n    @media (min-width: 1024px) {\n      .intel-rec-skeleton-ribbon-box {\n        flex-wrap: nowrap;\n      }\n      .intel-rec-skeleton-ribbon-item {\n        --slide-spacing: 16px;\n        flex: 0 0 calc(100% / var(--slides-per-page-lg));\n      }\n      .intel-rec-skeleton-ribbon-image {\n        width: var(--slide-image-width, 105px);\n      }\n    }\n\n    @media (min-width: 1280px) {\n      .intel-rec-skeleton-ribbon-box {\n        flex-wrap: nowrap;\n      }\n      .intel-rec-skeleton-ribbon-item {\n        --slide-spacing: 16px;\n        flex: 0 0 calc(100% / var(--slides-per-page-xl));\n      }\n    }\n\n    @media (min-width: 1440px) {\n      .intel-rec-skeleton-ribbon-box {\n        flex-wrap: nowrap;\n      }\n      .intel-rec-skeleton-ribbon-item {\n        --slide-spacing: 16px;\n        flex: 0 0 calc(100% / var(--slides-per-page-2xl));\n      }\n    }\n\n    @media (min-width: 1640px) {\n      .intel-rec-skeleton-ribbon-box {\n        flex-wrap: nowrap;\n      }\n      .intel-rec-skeleton-ribbon-item {\n        --slide-spacing: 16px;\n        flex: 0 0 calc(100% / var(--slides-per-page-3xl));\n      }\n    }\n\n    @media (min-width: 1840px) {\n      .intel-rec-skeleton-ribbon-box {\n        flex-wrap: nowrap;\n      }\n      .intel-rec-skeleton-ribbon-item {\n        --slide-spacing: 16px;\n        flex: 0 0 calc(100% / var(--slides-per-page-4xl));\n      }\n    }\n  \u003c/style\u003e\n  \u003cdiv class=\"expanded intel-rec-skeleton-ribbon-container\"\u003e\n    \u003cdiv class=\"intel-rec-skeleton-ribbon\" data-testid=\"skeleton-carousel\"\u003e\n      \u003cspan class=\"intel-rec-skeleton-animation intel-rec-skeleton-title\"\u003e\u003c/span\u003e\n      \u003cdiv class=\"intel-rec-skeleton-ribbon-box\"\u003e\n        \u003cdiv title=\"Skeleton carousel item\" class=\"intel-rec-skeleton-ribbon-item\"\u003e\n          \u003cspan class=\"intel-rec-skeleton-animation intel-rec-skeleton-ribbon-image\"\u003e\u003c/span\u003e\n          \u003cdiv class=\"intel-rec-skeleton-ribbon-title-container\"\u003e\n            \u003cspan class=\"intel-rec-skeleton-animation\" style=\"width: 100%; height: 15px\"\u003e\u003c/span\u003e\n            \u003cspan class=\"intel-rec-skeleton-animation\" style=\"width: 55%; height: 15px\"\u003e\u003c/span\u003e\n            \u003cspan class=\"intel-rec-skeleton-animation\" style=\"width: 0; height: 4px\"\u003e\u003c/span\u003e\n            \u003cspan class=\"intel-rec-skeleton-animation\" style=\"width: 30%; height: 16px\"\u003e\u003c/span\u003e\n          \u003c/div\u003e\n        \u003c/div\u003e\n        \u003cdiv title=\"Skeleton carousel item\" class=\"intel-rec-skeleton-ribbon-item\"\u003e\n          \u003cspan class=\"intel-rec-skeleton-animation intel-rec-skeleton-ribbon-image\"\u003e\u003c/span\u003e\n          \u003cdiv class=\"intel-rec-skeleton-ribbon-title-container\"\u003e\n            \u003cspan cla