        <script>
            // Fetch and populate SVG symbols before React hydration
            (function() {
                var filenamesList = [{"type":"default","filename":"next-default.svg","src":"/static-content/ux-fabric/iconography-graphics/logotype/next-default.svg"},{"type":"nexthome","filename":"next-home-default.svg","src":"/static-content/ux-fabric/iconography-graphics/logotype/next-home-default.svg"}];
                var sprite = document.getElementById('tabbed-nav-sprite');
                var defs = sprite ? sprite.querySelector('defs') : null;
                var loaded = 0;
                
                filenamesList.forEach(function(item) {
                    var url = item.src;
                    var type = item.type;
                    var xhr = new XMLHttpRequest();
                    xhr.open('GET', url, true);
                    xhr.onload = function() {
                        if (xhr.status === 200 && defs) {
                            var parser = new DOMParser();
                            var doc = parser.parseFromString(xhr.responseText, 'image/svg+xml');
                            var svgElement = doc.documentElement;
                            
                            // Use the type as the unique identifier
                            var uniqueId = type;
                            
                            // Copy all child elements into the defs with unique IDs
                            Array.from(svgElement.children).forEach(function(child) {
                                var clonedChild = child.cloneNode(true);
                                
                                // If the child has an ID, make it unique by prefixing with type
                                if (clonedChild.id) {
                                    clonedChild.id = uniqueId + '-' + clonedChild.id;
                                } else {
                                    // If no ID, create one based on the type
                                    clonedChild.id = uniqueId + '-default';
                                }
                                
                                defs.appendChild(clonedChild);
                            });
                            
                            loaded++;
                            if (loaded === filenamesList.length) {
                                // All SVGs loaded, dispatch event for React components
                                window.dispatchEvent(new Event('tabbed-nav-sprites-loaded'));
                            }
                        }
                    };
                    xhr.send();
                });
            })();
        </script>
