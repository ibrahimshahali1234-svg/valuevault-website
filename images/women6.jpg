</style><style id="sierra-core-part-css">[data-sierra-chat-container]::part(chat) { --chat-color-title-bar: #F7F7F7; --chat-color-title-bar-text: #000000; --chat-color-background: #FFFFFF; --chat-color-user-bubble: #E8E0FF; --chat-color-user-text: #000000; --chat-color-assistant-bubble: #ffffff; --chat-color-assistant-text: #000000; --chat-color-new-chat-button: #3511B8; --chat-font-family: "next-display-400", "Poppins", sans-serif; }
[data-sierra-chat-container]::part(chat-title-bar) { background: #F7F7F7 !important; border-bottom: 1px solid #EEEEEE !important; font-family: "next-display-400", sans-serif !important; }
[data-sierra-chat-container]::part(chat-title-bar-logo) { width: 32px !important; height: 32px !important; object-fit: contain !important; }
[data-sierra-chat-container]::part(chat-title-bar-text) { color: #000000 !important; font-weight: 600 !important; padding-left: 32px !important; font-size: 1rem !important; }
[data-sierra-chat-container]::part(chat-title-bar-button-actions) { background: transparent !important; color: #000000 !important; border-radius: 6px !important; padding: 4px 8px !important; }
[data-sierra-chat-container]::part(chat-title-bar-button-close) { color: #000000 !important; }
[data-sierra-chat-container]::part(chat-bubble-user) { background: rgba(232,224,255,1) !important; color: #000 !important; }
[data-sierra-chat-container]::part(chat-bubble-assistant) { background: #ffffff !important; color: #000 !important; border: 1px solid #E1E8F5 !important; }
[data-sierra-chat-container]::part(chat-body) { font-family: "next-display-400", sans-serif !important; background: #FFFFFF !important; }
[data-sierra-chat-container]::part(chat-messages) { background: #FFFFFF !important; }
[data-sierra-chat-container]::part(chat-input) { font-family: "next-display-400", sans-serif !important; border: 1px solid #E1E8F5 !important; border-radius: 16px !important; }
[data-sierra-chat-container]::part(chat-corner-container) { border-radius: 16px !important; box-shadow: 0 8px 32px rgba(0,0,0,0.15) !important; overflow: hidden !important; }
@media (max-width: 767px) { [data-sierra-chat-container]::part(chat-corner-container) { width: 100% !important; height: 100% !important; border-radius: 0 !important; box-shadow: none !important; } }
[data-sierra-chat-container]::part(chat-send-button) { background: linear-gradient(180deg, rgba(53,17,184,1) 0%, rgba(24,8,82,1) 100%) !important; border-radius: 12px !important; }
[data-sierra-chat-container]::part(chat-new-button) { background: linear-gradient(180deg, rgba(53,17,184,1) 0%, rgba(24,8,82,1) 100%) !important; color: #fff !important; border-radius: 12px !important; }
[data-sierra-chat-container]::part(chat-disclosure) { font-size: 10px !important; color: #949494 !important; }</style><style>

#uio-pdp-entrypoint-below-ribbons-parent #uio-technical-features-accordion {
	margin-top: -24px;
}

#uio-technical-features-accordion .uio-techincal-features-subtitle2 {
    margin: 0;
    font-family: next-display-700, -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Oxygen, Ubuntu, Cantarell, 'Open Sans', 'Helvetica Neue', sans-serif;
    color: rgba(0, 0, 0, 1);
    font-size: 0.875rem; /* 14px */
    line-height: 1.5; /* 21px */
    letter-spacing: 0;
    font-weight: 700;
    text-transform: none;
}

/* Divider */
#uio-technical-features-accordion .uio-technical-accordion-divider, #uio-technical-features-accordion .uio-technical-accordion-divider-0 {
    margin: 0;
    flex-shrink: 0;
    border-width: 0;
    border-style: solid;
    border-color: rgba(238, 238, 238, 1);
    border-bottom-width: thin;
}

#uio-technical-features-accordion .uio-technical-accordion-divider-0 {
	display:none;
}

/* Accordion header container */
#uio-technical-features-accordion .uio-technical-accordion-details-4 {
	

        display: inline-flex;
    align-items: center;
    justify-content: center;
    position: relative;
    box-sizing: border-box;
    -webkit-tap-highlight-color: transparent;
    background-color: transparent;
    outline: 0;
    border: 0;
    margin: 0;
    border-radius: 0;
    padding: 0;
    cursor: pointer;
    user-select: none;
    vertical-align: middle;
    -moz-appearance: none;
    -webkit-appearance: none;
    text-decoration: none;
    color: inherit;
    display: flex;
    min-height: 48px;
    /*padding: 0px 8px;*/
    transition: min-height 150ms 
cubic-bezier(0.4, 0, 0.2, 1) 0ms, background-color 150ms 
cubic-bezier(0.4, 0, 0.2, 1) 0ms;

	
    display: flex;
    align-items: center;
    margin-bottom: -1px;
    min-height: 44px;
    /*padding: 10px 16px;
    padding-right: 12px;*/
    padding: 10px 0;
}

/* Header content */
#uio-technical-features-accordion .uio-technical-accordion-details-5 {
    display: flex;
    flex-grow: 1;
    margin: 12px 0;
}

/* Features container (expanded content) */
#uio-technical-features-accordion .uio-technical-accordion-details-7.uio-accordion-expanded {
    /*padding: 0 16px 16px 16px;*/
    padding: 0 0 16px 0;
}

/* Each feature tile */
#uio-technical-features-accordion .uio-technical-feature {
    display: flex;
    /*height: 249px;*/
    padding: 0 16px 16px 0;
    align-items: flex-start;
    gap: 12px;
    align-self: stretch;
}

/* Feature image */
/*#uio-technical-features-accordion .uio-technical-feature-image {
    width: 80px;
    height: auto;
    flex-shrink: 0;
    border-radius: 4px;
}*/

/* Feature description container */
#uio-technical-features-accordion .uio-technical-feature-text {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 16px;
    flex: 1 0 0;
    margin: 0;
}

/* Feature description header */
#uio-technical-features-accordion .uio-technical-feature-text h3 {
    color: rgba(0, 0, 0, 1);
    font-feature-settings: 'liga' off, 'clig' off;
    font-family: next-display-700, -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Oxygen, Ubuntu, Cantarell, 'Open Sans', 'Helvetica Neue', sans-serif;
    font-size: 0.875rem;
    font-style: normal;
    font-weight: 700;
    line-height: 150%; /* 21px */
    margin: 0;
}

/* Feature description details */
#uio-technical-features-accordion .uio-technical-feature-text p {
    color: rgba(0, 0, 0, 1);
    font-feature-settings: 'liga' off, 'clig' off;
    font-family: next-display-text-400, -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Oxygen, Ubuntu, Cantarell, 'Open Sans', 'Helvetica Neue', sans-serif;
    font-size: 0.75rem;
    font-style: normal;
    font-weight: 400;
    line-height: 150%; /* 18px */
    letter-spacing: 0;
    margin: 0;
}

#uio-technical-features-accordion .uio-technical-feature-image {
  width: 186px;
  height: 233px;
  aspect-ratio: 186 / 233;
  flex-shrink: 0;
  border-radius: 4px;
  /*object-fit: contain; */
  border: 1px solid rgba(234, 234, 234, 1);
}

/* Chevron wrapper, mimicking on-page behavior */
.uio-chevron-wrapper {
  display: flex;
  color: #000;
  transform: rotate(0deg);
  transition: transform 150ms cubic-bezier(0.4, 0, 0.2, 1);
}

/* When accordion is expanded */
.uio-chevron-wrapper.Mui-expanded {
  transform: rotate(180deg);
}



/* Responsive: Reset positioning on smaller screens */
/*@media (max-width: 1024px) {
    #uio-technical-features-accordion {
        position: static !important;
        width: auto !important;
        left: auto !important;
        top: auto !important;
    }
}*/
@media (max-width: 500px) {
    #uio-technical-features-accordion .uio-technical-accordion-details-7 {
    padding: 10px 16px;
    padding-right: 12px;
    }
    
    #uio-technical-features-accordion .uio-technical-accordion-details-4 {
    display: flex;
    align-items: center;
    margin-bottom: -1px;
    min-height: 44px;
    padding: 10px 16px;
    padding-right: 12px;
    }
    
    #uio-pdp-entrypoint-below-ribbons-parent #uio-technical-features-accordion {
	margin-top: 0px;
    }
}

@media (min-width: 501px) and (max-width: 1023px) {
	#uio-technical-features-accordion .uio-technical-accordion-divider-0 {
		display: block;
	}
}

    
