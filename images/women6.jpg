            #ot-anchor{
     border-radius: 0px 0px 40px 0px!important;
   }

#filter-apply-handler, #filter-cancel-handler{
    letter-spacing:1px!important;
    font-weight: 600!important;
  }
#onetrust-pc-sdk #ot-host-lst .ot-acc-txt{
font-family: next-display-400, Poppins-400, Poppins,  'Poppins-Regular', AzoSans, 'azo-sans'!important
}
#onetrust-pc-sdk .ot-host-opt{
font-family: next-display-400, Poppins-400, Poppins,  'Poppins-Regular', AzoSans, 'azo-sans'!important
}
#onetrust-pc-sdk .ot-host-expand{
font-family: next-display-400, Poppins-600, Poppins,  'Poppins-Regular', AzoSans, 'azo-sans'!important;
}
#onetrust-pc-sdk .ot-search-cntr {
    font-family: next-display-400, poppins-400 !important;
    font-synthesis-style: none !important;
}
    
 #ot-pc-lst h3, #ot-pc-lst h4
 {
    font-family: next-display-700, Poppins-600, Poppins,  'Poppins-Regular', AzoSans, 'azo-sans'!important;
    }

#ot-pc-lst button {
    font-family: next-display-700, Poppins-600, Poppins,  'Poppins-Regular', AzoSans, 'azo-sans'!important;
    }
#onetrust-pc-sdk #no-results p
{
font-family: next-display-400, Poppins-600, Poppins,  'Poppins-Regular', AzoSans, 'azo-sans'!important;
}
#onetrust-pc-sdk #no-results p span
{
font-family: next-display-700, Poppins-600, Poppins,  'Poppins-Regular', AzoSans, 'azo-sans'!important;
}

.ot-acc-txt
{
font-family: next-display-400, Poppins-400, Poppins,  'Poppins-Regular', AzoSans, 'azo-sans'!important;
}
    
    #onetrust-pc-sdk #filter-btn-handler{
    background-color:#000000 !important;
    }
    
    #onetrust-pc-sdk #filter-btn-handler:hover{
    background-color:#000000 !important;
    opacity:1!important;
    }

/*scrollbar*/
    #onetrust-pc-sdk .ot-fltr-scrlcnt{
      max-height: calc(100% - 47px)!important;
      overflow-y: auto !important;
    }

/* Removes bolding from the Cookie Detail labels */
#onetrust-pc-sdk .ot-host-opt li dl dt {
    font-weight: normal !important;
}

#filter-cancel-handler{
    color:#000000!important;
    background-color:#FFFFFF!important;
    border:1px solid #000000!important;
    border-radius:4px!important;
    text-transform: uppercase !important;
    width: 90% !important;
    margin-left: 16px!important;
    margin-right: 8px!important;
    margin-bottom: 0px!important;
    }
    
    #filter-apply-handler{
    color:#FFFFFF!important;
    background-color:#000000 !important;
    border-color:#000000 !important;
    border-radius:4px!important;
    text-transform: uppercase !important;
    width: 90% !important;
    margin-left: 16px!important;
    margin-right: 8px!important;
    margin-bottom: 8px!important
}

    #filter-apply-handler:hover{
    background-color:#000000 !important;
    border-color:#000000 !important;
    opacity:1!important;
    }

    #onetrust-pc-sdk .ot-chkbox label::before{
    /*background-color: rgba(37,127,57,.05)!important;*/
    background-color:#FFF!important;
    border:1px solid #D2D2D2;
    outline-width:0px!important;
    border-radius:4px!important;
    width:20px!important;
    height:20px!important;
    }
    
    #onetrust-pc-sdk .ot-chkbox label::before:hover{
     border:1px solid #006060!important;
    }
    
/*version upgrade-filter pop fix */    
   #onetrust-pc-sdk #ot-filter-list-header{
     display: none;
}
#onetrust-pc-sdk .ot-fltr-opt {
  list-style: none;
}

 #onetrust-pc-sdk .ot-chkbox input:checked~label::before{
    border:2px solid #183D2A!important;
    outline-width:0px!important;
    }
    #onetrust-pc-sdk .ot-chkbox input[type=checkbox]+label::after{
    color:#000!important;
    width:12px!important;
    height:7px!important;
    }
    
    #onetrust-pc-sdk #vendor-search-handler{
    border-radius:4px!important;
    }
    
    .ot-search-cntr svg{
    border-left:1px solid #C0C0C0!important;
    padding-left:15px!important;
    }
    
    #clear-filters-handler{
    width:auto!important;
    color:#000000 !important;
    }
    
    #clear-filters-handler:hover{
    color:#000000 !important;
    opacity:1!important;
    }
    
 #onetrust-pc-sdk #ot-fltr-modal .ot-label-txt{
    font-family: next-display-text-400, poppins-400, Poppins, 'Poppins-Regular',  AzoSans, 'azo-sans'!important;
    }
    
 #onetrust-pc-sdk .ot-fltr-opt{
    margin-bottom:5px!important;
    }
    
 #ot-fltr-cnt .ot-fltr-scrlcnt{
        background-color: #FFFFFF;
        width: 100%;
        padding-top: 10px;
        border-top: 1px solid #eee!important;
        overflow:hidden;
    }

 #ot-fltr-cnt .ot-fltr-btns{
        padding-top: 18px!important;
        background-color: #f7f7f7;
        border-top: 1px solid #eee!important;
        display: flex;
        flex-direction: column;
        margin-bottom:0px!important;
        margin-left: 0px !important;
        padding-bottom: 12px !important;
        margin-top: 24px !important;
    }
    
    #onetrust-pc-sdk #ot-fltr-cnt{
    padding-bottom:0px!important;
    padding-right:0px;
    margin-top: 7px !important;
    max-height: 370px !important;
    }
    
    #onetrust-pc-sdk .ot-search-cntr>svg{
    width:40px!important;
    }

  #onetrust-pc-sdk .ot-chkbox:has(.category-filter-handler:checked) label::before,
  #onetrust-pc-sdk .category-filter-handler:checked + label::before{
      border: 2px solid #183D2A!important;
    }
    
/*Focus - Accessibility */    

#onetrust-pc-sdk .ot-host-item > button:focus, #onetrust-pc-sdk .ot-ven-item > button:focus {
     outline: none !important;
     border: none !important;
}
#onetrust-pc-sdk .ot-host-item > button:focus-visible, #onetrust-pc-sdk .ot-ven-item > button:focus-visible{
   outline: 2px solid #1d89dd !important;
    outline-offset: 2px;
}

input#vendor-search-handler::placeholder{
font-family: next-display-400, poppins-400, Poppins, 'Poppins-Regular',  AzoSans, 'azo-sans'!important;
}

/*footer space adjustment*/
#onetrust-pc-sdk #ot-pc-lst{
    bottom: var(--ot-footer-space) !important;
}

#clear-filters-handler{
      margin-right:10px;
      margin-top:16px!important;
      margin-bottom:14px!important;
}

/iphone-14 filer pop up-fix */    
@media screen and (max-width: 430px) {
  #ot-fltr-cnt .ot-fltr-btns {
    flex-direction: column;
  }
}
@media only screen and (min-width: 477px) and (max-width: 630px) {
    #filter-apply-handler{
        width: 43%!important;
        margin-left: 16px!important;
        margin-right: 8px!important;
        margin-bottom:0px!important;
  }
    #filter-cancel-handler{
        width: 43%!important;
        margin-bottom:0px!important;
  }
 }
@media only screen and (max-width: 330px) {
    #ot-fltr-cnt .ot-fltr-btns{
        padding-left:20px!important;
