            #onetrust-consent-sdk #onetrust-pc-sdk .ot-tgl input:focus + .ot-switch, .ot-switch .ot-switch-nob, .ot-switch .ot-switch-nob:before,
            #onetrust-pc-sdk .ot-checkbox input[type="checkbox"]:focus + label::before,
            #onetrust-pc-sdk .ot-chkbox input[type="checkbox"]:focus + label::before {
                outline-color: #000000;
                outline-width: 1px;
                outline-offset: 1px;
            }
            #onetrust-pc-sdk .ot-host-item > button:focus, #onetrust-pc-sdk .ot-ven-item > button:focus {
                border: 1px solid #000000;
            }
            #onetrust-consent-sdk #onetrust-pc-sdk *:focus,
            #onetrust-consent-sdk #onetrust-pc-sdk .ot-vlst-cntr > a:focus {
               outline: 1px solid #000000;
               outline-offset: 1px;
            }#onetrust-pc-sdk{
  min-height:480px!important;
}

#onetrust-pc-sdk .ot-pc-logo
{
    height: 20px !important;
    width: 82.91px !important;
}

#onetrust-pc-sdk .ot-pc-logo img
{
   display:block !important
}

#ot-pc-content h3,
#ot-pc-content h4{
font-family: next-display-700, poppins-500, Poppins, AzoSans, 'azo-sans' !important;
}
#ot-pc-content div {
  font-family: next-display-400, poppins-500, Poppins, AzoSans, 'azo-sans' !important;
}
#accept-recommended-btn-handler {
  font-size: 14px !important;
  padding: 0px 24px 0px 24px !important;
  font-family: next-display-700, poppins-600, Poppins, AzoSans, 'azo-sans' !important;
  letter-spacing: 1px !important;
  width:100% !important;
  box-sizing: border-box !important;
  text-align: center !important;
  max-width: none !important;
  margin-bottom: 15px !important;
  margin-top: 15px !important;
}

#onetrust-pc-sdk .ot-pc-header {
  border-bottom: none;
  font-family: next-display-800, Poppins, AzoSans, 'azo-sans' !important;
  height: 52px !important;
  padding: 10px 16px 10px 16px !important;
  display: flex !important;
  justify-content: center !important;
  align-items: center !important;
}
.ot-hlst-cntr a,
.ot-hlst-cntr .ot-link-btn {
  text-decoration: underline !important;
  font-family: next-display-text-700, Poppins !important;
  font-weight: 500 !important;
  font-size: 12px !important;
  color: #000000 !important;
}

.ot-pc-footer-logo {
  display: none;
}

.ot-pc-footer{
background-color: #f7f7f7!important;
}

#ot-pc-title {
  font-size: 14px !important;
  font-family: next-display-700, poppins-500, Poppins, AzoSans, 'azo-sans' !important;
  font-weight:700 !important;
  letter-spacing: 0px !important;
  padding-bottom: 10px !important;
}
#ot-category-title
{
 font-family: next-display-700, poppins-500, Poppins, AzoSans, 'azo-sans' !important;
}
.ot-always-active {
  font-size:14px !important;
  color:#000000 !important;
margin-top: 10px !important;
}
#onetrust-pc-sdk .ot-vs-list .ot-always-active, #onetrust-pc-sdk .ot-cat-grp .ot-always-active
{
font-family: next-display-700, poppins-500, Poppins, AzoSans, 'azo-sans' !important;
}
#onetrust-pc-sdk .ot-cat-item p {
  font-size: 12px !important;
  font-family: next-display-text-400, Poppins !important;
  font-weight: 400 !important;
  padding-top: 5px !important;
}
.onetrust-close-btn-handler {
  color: #FFFFFF !important;
  background-color: #000000 !important;
  border-radius: 4px !important;
  font-family: next-display-700, poppins-600, Poppins, AzoSans, 'azo-sans' !important;
  font-size: 14px !important;
  padding: 0px 24px 0px 24px !important;
  width: 100% !important;
  letter-spacing: 1px !important;
  margin-top: unset !important;
}

.save-preference-btn-handler
{
  font-weight:600!important;
letter-spacing: 1px !important;
}

.save-preference-btn-handler.onetrust-close-btn-handler:hover {
  background-color: #000000 !important;
  opacity: 1!important;
}
#onetrust-pc-sdk .ot-cat-header {
margin-top: 10px !important;
width: calc(100% - 105px) !important;
}

/*Focus - accessibility */
#onetrust-pc-sdk .ot-tgl input:focus+.ot-switch {
    outline: none !important;
}
#onetrust-pc-sdk .ot-tgl input:focus-visible+.ot-switch {
    outline: 2px solid #1d89dd !important;
    outline-offset: 2px;
}
#onetrust-pc-sdk *:focus{
    outline: none !important;
}
#onetrust-pc-sdk *:focus-visible {
    outline: 2px solid #1d89dd !important;
    outline-offset: 2px;
}

#onetrust-pc-sdk.ot-ftr-stacked .ot-btn-container
{
  width: unset !important; 
  margin: unset !important;
}

#onetrust-pc-sdk .ot-btn-container.ot-button-order-container
{
padding: 0px 15px 0px 15px !important;
}

#ot-pc-desc,
.ot-category-desc {
  font-size: 12px !important;
}

#ot_Onsite_desc_extra, #ot_Func_desc_extra{
display:block!important;
font-size: 12px !important;
line-height: 1.5 !important;
}

.category-host-list-handler {
  margin-bottom: 10px !important;
}
#onetrust-pc-sdk .ot-tgl input:checked + .ot-switch .ot-switch-nob {
  background-color: #000000!important;
}
#onetrust-pc-sdk .ot-tgl input:checked + .ot-switch .ot-switch-nob:hover {
  background-color: #000000 !important;
}

#onetrust-pc-sdk .ot-switch{
width: 64px !important;
height: 36px !important;
}

#onetrust-pc-sdk .ot-switch-nob {
  background-color: #eaeaea !important;
  border-radius: 18px !important;
}

#onetrust-pc-sdk .ot-switch-nob:before {
  background-color: #ffffff !important;
  border: 1px solid #d1d1d1 !important;
  height: 24px !important;
  width: 24px !important;
  top: 5px !important;
  left: 6px !important;
}

#onetrust-pc-sdk .ot-tgl input:checked+.ot-switch .ot-switch-nob:before
{
    transform: translateX(27px) !important;
}

/*.ot-switch, .ot-hlst-cntr a{
outline:none!important;
}*/
.ot-pc-refuse-all-handler {
  display: none !important;
}
#accept-recommended-btn-handler {
  color: #ffffff!important;
  display: block !important;
  border-radius: 4px !important;
background-color:#000000 !important;
font-weight:600!important;
}
#accept-recommended-btn-handler:hover{
background-color:#000000 !important;
opacity: 1!important;
}

#ot-category-title {
  font-size: 14px !important;
  font-weight:700 !important;
  letter-spacing:0px !important;
}

.ot-cat-header{
   font-weight:700 !important;
   font-family: next-display-700, poppins-500, Poppins, AzoSans, 'azo-sans' !important;
   font-size: 14px !important;
   letter-spacing: 0px !important;
}

#onetrust-pc-sdk .ot-tgl input:checked+.ot-switch .ot-switch-nob{
  border: 1px solid #000000!important;
}

#onetrust-pc-sdk #ot-pc-desc{
margin-bottom: 15px !important;
}
#onetrust-pc-sdk #ot-pc-desc a {
  margin-left:0px!important;
  color: #000000!important;
  font-weight:700!important;
  font-family: next-display-text-700, poppins-500, Poppins, AzoSans, 'azo-sans' !important;
}

#onetrust-pc-sdk #ot-pc-content {
  width: calc(100% - 12px) !important;
  overflow-x: hidden !important;
}

#ot_toggle_desc_extra, #ot_toggle_desc_onsite_extra, #ot_toggle_desc_performance_extra {
display:block!important;
 font-weight:700 !important;
font-family: next-display-700, poppins-500, Poppins, AzoSans, 'azo-sans' !important;
font-size: 13px !important;
letter-spacing: 0px !important;
text-align: right !important;
padding-top: 10px !important;
}

#clear-filters-handler{
margin-right:10px!important;
}

/*footer space adjustment*/
#ot-pc-content, 
#ot-pc-lst,
#ot-pc-footer ot-pc-scrollbar {
    --ot-footer-space: 160px !important;
}
#onetrust-pc-sdk.ot-ftr-stacked #ot-pc-lst {
    bottom: var(--ot-footer-space);
}

#onetrust-pc-sdk.ot-ftr-stacked .ot-pc-footer button {
    margin-left: 0px !important;
    margin-right: 0px !important;
}


@media only screen and (max-width: 560px) {
  #onetrust-pc-sdk .ot-pc-header {
    padding: 10px 0 10px 10px !important;
  }
  #onetrust-pc-sdk .ot-btn-container {
    margin-left: 10px;
    margin-right: 10px;
  }
  #onetrust-pc-sdk #ot-pc-content, #onetrust-pc-sdk.ot-ftr-stacked .ot-btn-container{
     margin-left:0px!important;
     padding-left:10px!important;
  }
}

@media only screen and (min-width: 561px) {
  .save-preference-btn-handler {
    max-width: none !important;
  }
  #onetrust-pc-sdk .ot-btn-container {
    text-align: left;
  }
}

@media only screen and (min-width: 477px) {
  #ot-category-title, .ot-cat-item, #ot-pc-title, #ot-pc-desc{
    margin-left:7px!important;
    width: calc(100% - 7px)!important;
  }
  #onetrust-pc-sdk #ot-pc-content{
    margin: 1px 3px 0 10px!important;
  }
}

@media only screen and (max-width: 599px) {
  #accept-recommended-btn-handler, .save-preference-btn-handler{
    height:44px!important;
    line-height:12px!important;
  }
}

@media only screen and (max-width: 600px){
  #onetrust-pc-sdk #ot-pc-content, #onetrust-pc-sdk.ot-ftr-stacked .ot-btn-container {
    width: 100%!important;
    margin-top: 15px !important;
  }
}

@media only screen and (min-width: 600px) {
  #accept-recommended-btn-handler, .save-preference-btn-handler{
    height:44px!important;
    line-height:150% !important;
  }
}
