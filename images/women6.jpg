/****************************************************************************************
 * Sierra Core CSS
 *
 * Global ::part() styling for the Sierra chat widget on Next.co.uk.
 * Applied once — either as an Exponea Global CSS asset or injected by the Sierra Global Tag.
 *
 * These rules style Sierra's shadow DOM via CSS Shadow Parts.
 ****************************************************************************************/

/* ================================================================
   Sierra Chat Widget — CSS Shadow Parts
   ================================================================ */

[data-sierra-chat-container]::part(chat) {
  --chat-color-title-bar: #F7F7F7;
  --chat-color-title-bar-text: #000000;
  --chat-color-background: #FFFFFF;
  --chat-color-user-bubble: #E8E0FF;
  --chat-color-user-text: #000000;
  --chat-color-assistant-bubble: #ffffff;
  --chat-color-assistant-text: #000000;
  --chat-color-new-chat-button: #3511B8;
  --chat-font-family: "next-display-400", "Poppins", sans-serif;
}

[data-sierra-chat-container]::part(chat-title-bar) {
  background: #F7F7F7 !important;
  border-bottom: 1px solid #EEEEEE !important;
  font-family: "next-display-400", sans-serif !important;
}

[data-sierra-chat-container]::part(chat-title-bar-logo) {
  width: 32px !important;
  height: 32px !important;
  object-fit: contain !important;
}

[data-sierra-chat-container]::part(chat-title-bar-text) {
  color: #000000 !important;
  font-weight: 600 !important;
  padding-left: 32px !important;
  font-size: 1rem !important;
}

[data-sierra-chat-container]::part(chat-title-bar-button-actions) {
  background: transparent !important;
  color: #000000 !important;
  border-radius: 6px !important;
  padding: 4px 8px !important;
}

[data-sierra-chat-container]::part(chat-title-bar-button-close) {
  color: #000000 !important;
}

[data-sierra-chat-container]::part(chat-bubble-user) {
  background: rgba(232, 224, 255, 1) !important;
  color: #000 !important;
}

[data-sierra-chat-container]::part(chat-bubble-assistant) {
  background: #ffffff !important;
  color: #000 !important;
  border: 1px solid #E1E8F5 !important;
}

[data-sierra-chat-container]::part(chat-body) {
  font-family: "next-display-400", sans-serif !important;
  background: #FFFFFF !important;
}

[data-sierra-chat-container]::part(chat-messages) {
  background: #FFFFFF !important;
}

[data-sierra-chat-container]::part(chat-input) {
  font-family: "next-display-400", sans-serif !important;
  border: 1px solid #E1E8F5 !important;
  border-radius: 16px !important;
  font-size: 16px !important;
}

[data-sierra-chat-container]::part(chat-corner-container) {
  border-radius: 16px !important;
  box-shadow: 0 8px 32px rgba(0, 0, 0, 0.15) !important;
  overflow: hidden !important;
}

[data-sierra-chat-container]::part(chat-send-button) {
  background: linear-gradient(180deg, rgba(53, 17, 184, 1) 0%, rgba(24, 8, 82, 1) 100%) !important;
  border-radius: 12px !important;
}

[data-sierra-chat-container]::part(chat-new-button) {
  background: linear-gradient(180deg, rgba(53, 17, 184, 1) 0%, rgba(24, 8, 82, 1) 100%) !important;
  color: #fff !important;
  border-radius: 12px !important;
}

[data-sierra-chat-container]::part(chat-disclosure) {
  font-size: 10px !important;
  color: #949494 !important;
}


/* ================================================================
   Mobile Responsive — Fullscreen chat on small screens
   ================================================================ */

@media (max-width: 767px) {
  /* Override Sierra's 30em x 40em corner dimensions to fullscreen */
  [data-sierra-chat-container]::part(chat-corner-container) {
    width: 100% !important;
    height: 100% !important;
    border-radius: 0 !important;
    box-shadow: none !important;
  }

  .clarity-trigger_floating-trigger {
    right: 12px !important;
    bottom: 70px !important;
    max-width: calc(100vw - 24px) !important;
    overflow: hidden !important;
  }

  .clarity-trigger_floating-trigger__button {
    max-width: 100% !important;
  }
}


</style><div tabindex="-1" aria-hidden="true"></div><div role="presentation" data-testid="superzoom-modal" class="MuiModal-root pdp-css-jclgz0"><div aria-hidden="true" class="MuiBackdrop-root MuiModal-backdrop pdp-css-919eu4" style="opacity: 1; background-color: white; transition: opacity 400ms cubic-bezier(0.4, 0, 0.2, 1);"></div><div tabindex="0" data-testid="sentinelStart"></div><div class="MuiBox-root pdp-css-byu33p" tabindex="-1" style="opacity: 1; transition: opacity 400ms cubic-bezier(0.4, 0, 0.2, 1);"><div data-testid="image-carousel-quick-actions" class="pdp-css-z0km4z"><button class="MuiButtonBase-root MuiIconButton-root MuiIconButton-sizeMedium pdp-css-1xyjg0u" tabindex="0" type="button" data-testid="image-carousel-quick-actions-close-superzoom"><div class="pdp-css-dga45d"><img src="./women6_files/cross-m-default.svg" alt="Close" aria-hidden="false" width="24" height="24"></div></button></div><div class="pdp-css-wmp7t7"><div class="pdp-css-1ek0kny"><div class="pdp-css-1vkyu24"><button class="MuiButtonBase-root Mui-disabled MuiIconButton-root Mui-disabled MuiIconButton-sizeMedium pdp-css-6nwret" tabindex="-1" type="button" data-testid="thumb-prev" disabled=""><div class="pdp-css-dga45d"><svg width="24" height="24" viewBox="0 0 24 24" aria-label="Show Previous Thumb Images" xmlns="http://www.w3.org/2000/svg"><use class="foreground" href="/static-content/ux-fabric/iconography-graphics/user-interface/next_revision/chevron-up-m-default.svg#default"></use></svg></div></button></div><div data-testid="pdp-thumbs" class="pdp-css-1e4773f"><button data-testid="pdp-thumb-0" class="active pdp-css-x4z9kt"><img src="./women6_files/G00406s.jpg" alt="Nike Black/White Flex Train Workout Trainers - Image 1 of 5" title="Nike Black/White Flex Train Workout Trainers - Image 1 of 5" height="120" width="90" loading="lazy" srcset="https://xcdn.next.co.uk/common/items/default/default/itemimages/3_4Ratio/product/lge/G00406s.jpg?im=Resize,width=90 1x, https://xcdn.next.co.uk/common/items/default/default/itemimages/3_4Ratio/product/lge/G00406s.jpg?im=Resize,width=180 2x"></button><button data-testid="pdp-thumb-1" class="pdp-css-x4z9kt"><img src="./women6_files/G00406s2.jpg" alt="Nike Black/White Flex Train Workout Trainers - Image 2 of 5" title="Nike Black/White Flex Train Workout Trainers - Image 2 of 5" height="120" width="90" loading="lazy" srcset="https://xcdn.next.co.uk/common/items/default/default/itemimages/3_4Ratio/product/lge/G00406s2.jpg?im=Resize,width=90 1x, https://xcdn.next.co.uk/common/items/default/default/itemimages/3_4Ratio/product/lge/G00406s2.jpg?im=Resize,width=180 2x"></button><button data-testid="pdp-thumb-2" class="pdp-css-x4z9kt"><img src="./women6_files/G00406s3.jpg" alt="Nike Black/White Flex Train Workout Trainers - Image 3 of 5" title="Nike Black/White Flex Train Workout Trainers - Image 3 of 5" height="120" width="90" loading="lazy" srcset="https://xcdn.next.co.uk/common/items/default/default/itemimages/3_4Ratio/product/lge/G00406s3.jpg?im=Resize,width=90 1x, https://xcdn.next.co.uk/common/items/default/default/itemimages/3_4Ratio/product/lge/G00406s3.jpg?im=Resize,width=180 2x"></button><button data-testid="pdp-thumb-3" class="pdp-css-x4z9kt"><img src="./women6_files/G00406s4.jpg" alt="Nike Black/White Flex Train Workout Trainers - Image 4 of 5" title="Nike Black/White Flex Train Workout Trainers - Image 4 of 5" height="120" width="90" loading="lazy" srcset="https://xcdn.next.co.uk/common/items/default/default/itemimages/3_4Ratio/product/lge/G00406s4.jpg?im=Resize,width=90 1x, https://xcdn.next.co.uk/common/items/default/default/itemimages/3_4Ratio/product/lge/G00406s4.jpg?im=Resize,width=180 2x"></button><button data-testid="pdp-thumb-4" class="pdp-css-x4z9kt"><img src="./women6_files/G00406s5.jpg" alt="Nike Black/White Flex Train Workout Trainers - Image 5 of 5" title="Nike Black/White Flex Train Workout Trainers - Image 5 of 5" height="120" width="90" loading="lazy" srcset="https://xcdn.next.co.uk/common/items/default/default/itemimages/3_4Ratio/product/lge/G00406s5.jpg?im=Resize,width=90 1x, https://xcdn.next.co.uk/common/items/default/default/itemimages/3_4Ratio/product/lge/G00406s5.jpg?im=Resize,width=180 2x"></button></div><div class="pdp-css-15uojl8"><button class="MuiButtonBase-root MuiIconButton-root MuiIconButton-sizeMedium pdp-css-sozmew" tabindex="0" type="button" data-testid="thumb-next"><div class="pdp-css-dga45d"><svg width="24" height="24" viewBox="0 0 24 24" aria-label="Show Next Thumb Images" xmlns="http://www.w3.org/2000/svg"><use class="foreground" href="/static-content/ux-fabric/iconography-graphics/user-interface/next_revision/chevron-down-m-default.svg#default"></use></svg></div></button></div></div></div><div data-testid="superzoom-container" role="presentation" title="Nike Black/White Flex Train Workout Trainers - Image 1 of 5" class="pdp-css-1el7plh" style="cursor: zoom-in;"><div class="react-transform-wrapper transform-component-module_wrapper__SPB86 " style="position: relative; width: 100%; height: 100%; transition: opacity 0.3s; opacity: 1;"><div class="react-transform-component transform-component-module_content__FBWxo " style="transform: translate(506.38px, 0px) scale(0.28625);"><img alt="Nike Black/White Flex Train Workout Trainers - Image 1 of 5" title="Nike Black/White Flex Train Workout Trainers - Image 1 of 5" data-testid="superzoom-image" src="./women6_files/G00406s(2).jpg"></div></div></div><div class="pdp-css-fq2gjh"><p class="MuiTypography-root MuiTypography-body1 pdp-css-11x7npk" data-testid="superzoom-product-title">Nike Black/White Flex Train Workout Trainers</p></div></div><div tabindex="0" data-testid="sentinelEnd"></div></div><style type="text/css">




.cui-powered-by,
.clarity-chat-powered-by-br-container {
  display: none !important;
}

/* ------------------------------------------------ */
/* Chat Header
/* ------------------------------------------------ */
/* Close */
#cocoaas_chat_wrapper .clarity-header-actions button[title="Minimize"] svg {
    display: none;
}
#cocoaas_chat_wrapper .clarity-header-actions button[title="Minimize"] {
    display: block;
    background-image: url('data:image/svg+xml,<svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 16 16" fill="rgb(0, 40, 64)" class="sc-brSamD grBisl clarity_light_close_icon clarity-light-close-icon"><path d="M3.52836 2.46965C3.23546 2.17677 2.76058 2.17678 2.4677 2.46969C2.17482 2.76259 2.17483 3.23746 2.46773 3.53035L6.93769 8.00001L2.46831 12.4697C2.17543 12.7626 2.17544 13.2375 2.46834 13.5303C2.76125 13.8232 3.23612 13.8232 3.52901 13.5303L7.99839 9.06063L12.4684 13.5303C12.7613 13.8232 13.2362 13.8232 13.5291 13.5303C13.8219 13.2374 13.8219 12.7625 13.529 12.4697L9.05901 7.99994L13.5283 3.53031C13.8212 3.23741 13.8212 2.76254 13.5283 2.46965C13.2354 2.17677 12.7605 2.17678 12.4676 2.46969L7.99832 6.93931L3.52836 2.46965Z"></path></svg>');
    width: 32px;
    height: 32px;
    background-size: 16px;
    background-repeat: no-repeat;
    background-position: center;
}

/* User Message */
#cocoaas_chat_wrapper .root_inside_shadow .clarity-user-text-message  {
  background-color: rgba(232, 224, 255, 1);
}

/* Clarity Message */
#cocoaas_chat_wrapper .clarity-chat-container .clarity-message-content .clarity_assistant_text_message > p:first-of-type {
  padding-left: 32px;
  position: relative;
}
#cocoaas_chat_wrapper .clarity-chat-container .clarity-message-content .clarity_assistant_text_message > p:first-of-type::before {
  background-image: url(https://brxcdn.com/nxt-app-storage/2917bfb4-eed8-11eb-9277-ca5aec699482/media/original/7aac6252-a44c-11f0-b6ba-9602cef3f2c7);
  background-size: cover;
  background-repeat: no-repeat;
  background-position: center;
  content: "";
  display: flex;
  flex: 1 0 24px;
  height: 24px;
  left: 0;
  margin-right: 8px;
  max-width: 24px;
  position: absolute;
  top: 0;
  width: 24px;
}

/* Carousel Item Image */
#cocoaas_chat_wrapper .root_inside_shadow .clarity-assistant-carousel-item-image {
  aspect-ratio: 2 / 3;
}

/* Product - Title */
#cocoaas_chat_wrapper .clarity-chat-container .clarity_product_title {
  font-family: 'next-display-400', sans-serif;
  font-size: 12px;
  font-weight: 400;
  line-height: 150%;
  text-decoration: none;
}

/* Product Price */
#cocoaas_chat_wrapper .clarity-chat-container .clarity-assistant-carousel-product .clarity-assistant-carousel-product-price {
  font-family: 'next-display-700', sans-serif;
  color: rgba(0, 0, 0, 1);
  font-size: 14px;
  font-weight: 700;
  line-height: 20px;
}

/* Add to Cart / View Product Button */
#cocoaas_chat_wrapper .clarity-chat-container .clarity-cart-icon {
  display: none;
}

/* Quick Reply Buttons */
#cocoaas_chat_wrapper > .root_inside_shadow .clarity_prompt_button {
  background: rgba(247, 249, 252, 1);
  border: 1px solid rgba(225, 232, 245, 1);
  padding-left: 14px;
  border-radius: 16px;
}
#cocoaas_chat_wrapper > .root_inside_shadow .clarity_prompt_button:hover {
  /* background-color: rgba(0, 87, 128, 1);
  border-color: rgba(0, 87, 128, 1); */
}
#cocoaas_chat_wrapper > .root_inside_shadow .clarity_prompt_button > svg {
  display: none;
}
#cocoaas_chat_wrapper > .root_inside_shadow .clarity_prompt_button::before {
  background-image: url(https://brxcdn.com/nxt-app-storage/2917bfb4-eed8-11eb-9277-ca5aec699482/media/original/7aac6252-a44c-11f0-b6ba-9602cef3f2c7);
  position: relative;
  width: 20px;
  height: 20px;
  background-size: 20px;
  background-repeat: no-repeat;
  background-position: center;
  content: '';
  display: inline-block;
}
/* #cocoaas_chat_wrapper > .root_inside_shadow .clarity_prompt_button .clarity-assistant-quick-reply-button-text  {
  color: rgba(255, 255, 255, 1);
  font-size: 14px;
  font-weight: 600;
  line-height: 20px;
} */

/* Minimized Prompts */
#cocoaas_chat_wrapper > .root_inside_shadow .clarity-chat-pdp-questions .clarity-gradient-button-wrapper::before {
  background: linear-gradient(180deg, rgba(53, 17, 184, 1) 0%, rgba(24, 8, 82, 1) 100%);
  border-radius: 10px;
}
#cocoaas_chat_wrapper > .root_inside_shadow .clarity-chat-pdp-questions .clarity-gradient-button-border {
  background: none;
  border-radius: 8px !important;
}
#cocoaas_chat_wrapper > .root_inside_shadow .clarity-chat-pdp-questions .clarity-gradient-button-content {
  border-radius: 8px !important;
}
#cocoaas_chat_wrapper > .root_inside_shadow .clarity-chat-pdp-questions .clarity-gradient-button-background {
  background: #fff;
  border-radius: 8px !important;
}


/* ------------------------------------------------ */
/* Chat Footer
/* ------------------------------------------------ */
/* Input Container */
#cocoaas_chat_wrapper .clarity-chat-footer .clarity_input_shadow.clarity-input-shadow.clarity-focused::before {
  display: none;
}

#cocoaas_chat_wrapper .clarity-input .clarity-input-textarea {
  border: unset !important;
}
/* Legal notice icon */
#cocoaas_chat_wrapper .root_inside_shadow .clarity-chat-footer .clarity_small_info_icon.clarity-small-info-icon {
  fill: #949494;
}




/* ================================================ */
/* Chat Badge
/* ================================================ */
#cocoaas_chat_wrapper > .root_inside_shadow .clarity-minimized {
	display: none !important;
}
#cocoaas_chat_wrapper > .root_inside_shadow .clarity-minimized .clarity_unread_message {
  background: rgba(0, 0, 0, 1);
}

/* Mobile */
@media screen and (max-width: 767px) {
  #cocoaas_chat_wrapper > .root_inside_shadow .clarity-minimized button.clarity_badge {
    position: fixed;
    bottom: 27px;
    right: 0px;
    width: 50px !important;
    height: 60px !important;
    gap: 8px;
    transform: rotate(-90deg) translateY(-100%) !important;
    transform-origin: right top !important;
    min-width: unset;
