#onetrust-banner-sdk p {
  font-family: next-display-400, poppins-400, Poppins, AzoSans, 'azo-sans' !important;
  font-size: 80pt;
}
#onetrust-banner-sdk .cookie-setting-link {
  white-space: nowrap !important;
}

.ot-pc-footer-logo {
  visibility: hidden;
}
#onetrust-policy-title {
  text-align: center!important;
  width:100%!important;
  padding: 0px 0px 0px 0px!important;
}
#onetrust-button-group {
  text-align: left !important;
  display: flex !important;
  flex-direction: column !important;
  align-items: start !important;
}
.banner-actions-container {
  float: none !important;
  width: 100% !important;
  text-align: center !important;
  margin-bottom: 17px !important;
  display: contents !important;
}
#onetrust-banner-sdk .has-reject-all-button .banner-actions-container {
    max-width: none !important;
}
#onetrust-policy-title {
  font-size: 18px !important;
font-weight: 500 !important;
  font-family: next-display-700, poppins-600, Poppins, AzoSans, 'azo-sans' !important;
letter-spacing:1px !important;
}
#onetrust-pc-btn-handler,
#onetrust-accept-btn-handler,
#onetrust-reject-all-handler {
  font-size: 14px !important;
  font-family: next-display-700, poppins-600, Poppins, AzoSans, 'azo-sans' !important;
  letter-spacing:1px !important;
}
#onetrust-policy-text
 {
  font-size: 15px !important;
  font-family: next-display-text-700, poppins-600, Poppins, AzoSans, 'azo-sans' !important;
}
#onetrust-accept-btn-handler #onetrust-reject-all-handler:hover{
background-color:#006060!important;
opacity: 1!important;
}
#onetrust-pc-btn-handler {
    color: #000000!important;
    text-decoration: underline !important;
    padding: 15px 15px !important;
    height: 70px !important;
    font-weight: 600!important;
    position: relative !important;
    max-width: fit-content !important;
    margin: 0 auto 20px auto !important;
    order: 3 !important;
    letter-spacing:1px !important;
    text-align: center !important;
}

#onetrust-pc-btn-handler .cookie-setting-link:hover{
background-color:#006060!important;
opacity: 1!important;
}

/* Manually manage link to set in middle */
#onetrust-banner-sdk #onetrust-button-group.ot-button-order-container *[class*=ot-button-order-]:last-of-type {
margin-right: auto !important;
}



#onetrust-reject-all-handler{
  border-radius: 4px !important;
  padding: 15px 15px !important;
  width: 100% !important;
  height: 70px !important;	
  letter-spacing:1px !important;
  order: 2 !important;
}
#onetrust-accept-btn-handler {
  border-radius: 4px !important;
  padding: 24px 24px !important;
  width: 100% !important;
  height: 70px !important;
  margin-bottom: 20px !important;
  order: 1 !important;
}
.ot-close-icon {
  opacity: 0.75 !important;
}
.onetrust-close-btn-handler.ot-close-icon {
   background-color:transparent!important;
}

#onetrust-banner-sdk .ot-close-icon {
  border: none !important;
}
#onetrust-close-btn-container button {
  margin-bottom: 0px !important;
  position: absolute
}

#onetrust-banner-sdk #onetrust-close-btn-container {
  margin-right: 30px !important;
}

#onetrust-consent-sdk *, #onetrust-consent-sdk *::before, #onetrust-consent-sdk *::after{
box-sizing:border-box !important;
}

.banner-header{
height:20px!important;
}

#onetrust-banner-sdk.otCenterRounded{
  width:90%!important;
  max-width:1600px!important;
  border-radius:8px!important;
}

#onetrust-banner-sdk #onetrust-policy-text a{
  margin-left:0px!important;
  font-weight:700!important;
  font-family: next-display-text-700, poppins-500, Poppins, AzoSans, 'azo-sans' !important;
}

#onetrust-banner-sdk #onetrust-policy-text p {
margin-bottom:15px!important;
}

.ot-sdk-row{
  max-width: 660px!important;
  margin-left:auto!important;
  margin-right:auto!important;
}

  #onetrust-button-group-parent{
    margin-bottom:15px!important;
  }

/* focus - accessibility */
#onetrust-consent-sdk #onetrust-banner-sdk.otCenterRounded: focus{
 outline: none !important;
}
#onetrust-consent-sdk #onetrust-banner-sdk *:focus, #onetrust-consent-sdk #onetrust-banner-sdk:focus {
    outline: none !important;
}
#onetrust-consent-sdk #onetrust-banner-sdk *:focus-visible, #onetrust-consent-sdk #onetrust-banner-sdk:focus-visible{
  outline: 2px solid #1d89dd !important;
  outline-offset: 2px;
}

@media only screen and (max-width: 425px) {
  #onetrust-banner-sdk.otCenterRounded {
    top: 50px !important;
    transform: none !important;
    -webkit-transform: none !important;
    bottom: 5px;
    height: fit-content;
  }
  #onetrust-button-group-parent {
    margin-top: 30px !important;
    font-family: next-display-700, poppins-600, Poppins,  AzoSans, 'azo-sans' !important;
  }
  #onetrust-policy-text {
    margin-top: 10px !important;
  }
  #onetrust-pc-btn-handler {
	  height: 70px !important;
          margin-bottom: 15px !important;
  }
  #onetrust-accept-btn-handler {
	  height: 70px !important;
           margin-bottom: 15px !important;
  }
  #onetrust-reject-all-handler {
	  height: 70px !important;
margin-bottom: 15px !important;
  }
}

#onetrust-close-btn-container{
  display:none !important;
}

@media only screen and (max-width: 320px) {
  #onetrust-button-group-parent {
    margin-top: 6px !important;
  }
}

@media only screen and (min-width: 321px) and (max-width: 599px) {
  #onetrust-banner-sdk #onetrust-button-group-parent {
    padding: 2px 22px !important;
  }
  #onetrust-button-group-parent {
    margin-top: 0px !important;
  }
#onetrust-banner-sdk #onetrust-policy-text p{
    margin-bottom: 12px !important;
  }
}

@media only screen and (min-width: 375px) and (max-width: 599px) {
  #onetrust-policy-text {
    margin: 10px 22px 0px 22px !important;
  }
}
@media only screen and (max-width: 699px) and (min-width: 600px) {
  #onetrust-policy-text {
    margin-top: 10px !important;
  }
}
@media only screen and (min-width: 700px) {
  #onetrust-button-group-parent {
    margin-top: 10px !important;
  }
  #onetrust-policy-text {
    margin: 15px 68px 0px 68px !important;
  }
  #onetrust-banner-sdk #onetrust-button-group-parent {
    padding: 15px 68px !important;
  }
  #onetrust-banner-sdk > div > .ot-sdk-row{
    margin-bottom:20px!important;
  }
  .ot-sdk-row #onetrust-button-group-parent{
    margin-bottom:0px!important;
  }
}
@media only screen and (max-width: 700px) and (min-width: 426px) {
  #onetrust-banner-sdk.otCenterRounded {
    top: 15% !important;
  }
}
@media only screen and (max-width: 896px) and (min-width: 701px) {
  #onetrust-banner-sdk.otCenterRounded {
    top: 10% !important;
    max-width: 640px!important;
  }

}
@media only screen and (min-width: 897px) {
  #onetrust-banner-sdk.otCenterRounded {
    top: 20px !important;
  }
}

@media only screen and (min-width: 897px) and (max-width:1280px) {
  #onetrust-banner-sdk.otCenterRounded {
    max-width:768px!important;
  }
  #onetrust-policy-text {
    margin: 15px 78px 10px 78px !important;
  }
  #onetrust-banner-sdk #onetrust-button-group-parent {
    padding: 2px 78px !important;
  }
}

@media only screen and (min-width: 1281px)  {
  #onetrust-banner-sdk.otCenterRounded {
    max-width:1024px!important;
  }
  #onetrust-policy-text {
    margin: 15px 78px 0px 78px !important;
  }
  #onetrust-banner-sdk #onetrust-button-group-parent {
    padding: 2px 78px !important;
  }
}

