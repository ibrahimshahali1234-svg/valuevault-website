 * Jinja Params Start. Do not edit these values.
 */



/*
 * Jinja Params End
 */
.weblayer--blank {
  display: block;
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  min-height: 70px;
  z-index: 2147483000; /* close to the highest possible z-index */
  font-family: Arial, Helvetica, sans-serif;
  font-size: 12px;
  line-height: normal;
  text-decoration: inherit;
  text-align: center;
  cursor: pointer;
  background: #00b7db;
}
.weblayer--blank:hover, .weblayer--blank:active {
  text-decoration: inherit;
}
.weblayer--blank > .close {
  /* inherits fs of 1rem defined in base styles */
  font-size: inherit;
  line-height: 1px;
  /* resets browser styles for button */
  color: transparent;
  background-color: transparent;
  top: 0;
  right: 0;
  padding: 0.5em;
  /* resets browser styles for button */
  border: 0;
  position: absolute;
  /* base class + 1 to prevent colliding of layers of clickable elements */
  z-index: 2147483001;
}
.weblayer--blank > .close:hover {
  cursor: pointer;
}
.weblayer--blank > .close:focus {
  outline: none;
}
.weblayer--blank > .inner {
  flex-wrap: wrap;
  display: flex;
  width: 100%;
  flex-direction: column;
  align-items: center;
  justify-content: center;
}
.weblayer--blank > .inner > .header {
  font-size: 10px;
  font-weight: bold;
  font-family: inherit;
  text-transform: uppercase;
  color: #1c1733;
  margin: 15px;
}
.weblayer--blank > .inner > .text {
  font-size: 24px;
  font-weight: 600;
  color: #ffffff;
  font-family: inherit;
  margin: 15px;
  margin-top: 0;
}</style><style id="sierra-header-trigger-css">.sierra-trigger_top-nav { display: inline-flex; align-items: center; justify-content: center; position: relative; z-index: 10000; font-family: next-display-400,Arial,sans-serif;; }
.sierra-trigger_top-nav--floating { position: fixed; pointer-events: auto; }
.sierra-trigger_top-nav--desktop { display: inline-flex; align-items: center; justify-content: center; margin-right: 16px; }
.sierra-trigger_top-nav__button { display: inline-flex; align-items: center; justify-content: center; width: 44px; height: 44px; padding: 0; margin: 0; background: transparent; border: none; border-radius: 50%; cursor: pointer; color: inherit; transition: background-color 0.2s ease, transform 0.2s ease; }
.sierra-trigger_top-nav__button:hover, .sierra-trigger_top-nav__button.hover-over { background-color: rgba(53, 17, 184, 0.08); }
.sierra-trigger_top-nav__button.hover-out { background-color: transparent; }
.sierra-trigger_top-nav__button:focus-visible { outline: 2px solid #3511B8; outline-offset: 2px; }
.sierra-trigger_top-nav__icon { display: inline-flex; align-items: center; justify-content: center; width: 24px; height: 24px; }
